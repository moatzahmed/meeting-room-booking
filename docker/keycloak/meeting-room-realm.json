{
  "realm": "meeting-room",
  "enabled": true,

  "roles": {
    "realm": [
      { "name": "ROLE_USER" },
      { "name": "ROLE_ADMIN" }
    ]
  },

  "clients": [
    {
      "clientId": "meeting-room-api",
      "name": "Meeting Room API",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:*/*"],
      "webOrigins": ["+"]
